{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
    "root": "apps/api",
    "framework": "nestjs",
    "buildCommand": "npm run build -w @hrms/shared && npm run build -w @hrms/api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/iclock/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
