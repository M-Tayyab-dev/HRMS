# Copy to .env (or run: node scripts/setup-env.mjs to generate secrets automatically)
NODE_ENV=development

# --- Database ---
PG_PORT=5433
PG_SUPERUSER_PASSWORD=change-me
PG_APP_PASSWORD=change-me
# Owner connection – used only for migrations
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5433/hrms
# Application connection – non-owner role, Row-Level Security enforced
DATABASE_URL=postgres://hrms_app:change-me@localhost:5433/hrms

# --- API ---
API_PORT=4000
APP_URL=http://localhost:3000
JWT_SECRET=change-me
DATA_HMAC_SECRET=change-me
# Optional (SEC-05): 32-byte base64 key for encrypting CNIC, salary and complaints at rest.
# If empty it is derived from DATA_HMAC_SECRET. Never change either once data exists.
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- Email (leave SMTP_URL empty in dev: emails are printed to the API log) ---
SMTP_URL=
MAIL_FROM="HRMS <no-reply@hrms.local>"

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
